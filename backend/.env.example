# Copy to .env and fill in. Never commit .env.

AWS_REGION=us-east-1
DYNAMODB_TABLE=ymcagrants
PORT=3000

# For DynamoDB Local, point the SDK at it instead of the real service:
# DYNAMODB_ENDPOINT=http://localhost:8000

# Credentials come from the usual AWS chain (profile, SSO, or instance role).
# Do not put access keys in this file.
