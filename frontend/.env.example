# Copy to .env.local to point the app at a deployed API.
# Unset, the app calls /api and the Vite dev proxy forwards to localhost:3000.

# VITE_API_BASE_URL=https://api.example.org

# Talk to the real backend instead of the in-browser stub API.
# VITE_API_MODE=live

# Where the dev server proxies /api. Defaults to http://localhost:3000; set it to
# the API Gateway invoke URL (stage included) to develop against AWS.
# API_PROXY_TARGET=https://abc123.execute-api.us-east-1.amazonaws.com/prod
